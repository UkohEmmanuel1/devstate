CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
