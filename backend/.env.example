DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
DATABASE_URL=postgresql://devstate:change-me@localhost:5432/devstate
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
# Set true in production
SECURE_SSL_REDIRECT=false
# Set 31536000 in production
SECURE_HSTS_SECONDS=0
DEVSTATE_PROJECTS_DIRS=
DEVSTATE_RECOVERY_DIR=./data/recovery
# Required for production hosting checks; proxy must enforce public-IP egress policy.
DEVSTATE_EGRESS_PROXY_URL=http://egress-proxy.internal:3128
# Required for production recovery snapshots (private S3-compatible bucket).
DEVSTATE_SNAPSHOT_BUCKET=devstate-private-snapshots
DEVSTATE_SNAPSHOT_REGION=eu-west-1
DEVSTATE_SNAPSHOT_ENDPOINT=
DEVSTATE_NTFY_SERVER=https://ntfy.sh
DEVSTATE_NTFY_TOPIC_PREFIX=
DEVSTATE_NTFY_TOPIC_SECRET=generate-a-long-random-secret
DEVSTATE_NTFY_TOKEN=
API_ANON_RATE=20/min
API_USER_RATE=300/min
API_PROJECT_SCAN_RATE=6/min
API_SNAPSHOT_RATE=5/hour
API_NOTIFICATION_RATE=5/min
API_INFRASTRUCTURE_CHECK_RATE=10/min
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production
